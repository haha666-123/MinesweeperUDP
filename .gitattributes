# 统一换行符策略
# 与 ModbusMonitor 保持一致：批处理必须 CRLF，源码与文档用 LF

* text=auto

# Windows 批处理必须是 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 源码与文档
*.cpp   text eol=lf
*.h     text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf
LICENSE      text eol=lf

# 二进制
*.exe   binary
*.dll   binary
*.a     binary
*.pdb   binary
*.png   binary
*.jpg   binary
*.ico   binary
*.wav   binary
*.mp3   binary
